# Copy to .env and fill in. Never commit .env.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: comma-separated allowlist of who may use the bot.
# Each entry can be a numeric Telegram user ID (e.g. 123456789) OR a
# username with or without @ (e.g. milopenggaosiewdai or @milopenggaosiewdai).
# Leave empty to make the bot public.
ALLOWED_USERS=

# Optional: your DEFAULT (home) market, used only when you haven't set a
# location at runtime. Day-to-day you don't touch these — use the /location
# command in chat to source for wherever you are (no redeploy needed).
# Defaults to Singapore if unset.
# NOTE: do not put inline (# ...) comments after a value — systemd reads this
# file literally and would include the comment in the value.
# SCOUT_COUNTRY must be a 2-letter ISO country code (e.g. SG, US, JP).
SCOUT_CITY=Singapore
SCOUT_REGION=Singapore
SCOUT_COUNTRY=SG
SCOUT_TIMEZONE=Asia/Singapore
